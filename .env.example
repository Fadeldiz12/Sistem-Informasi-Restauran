APP_NAME="Resto Flow"
APP_ENV=local
APP_KEY=
# Saat mengganti APP_KEY: pindahkan kunci lama ke sini (pisahkan koma), lalu jalankan "php artisan resto:rotasi-kunci"
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Password memakai Argon2id (otomatis bcrypt bila PHP tidak mendukung). Hash lama diperbarui saat pengguna login.
# HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Otomatis aktif bila APP_URL memakai https://
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backup terenkripsi (php artisan resto:backup, otomatis tiap malam)
# Buat kunci: php artisan resto:kunci-backup  -> simpan salinannya DI LUAR server
BACKUP_KEY=
# Folder kedua untuk salinan backup (flashdisk / NAS / folder OneDrive atau Google Drive)
BACKUP_SALINAN_FOLDER=
BACKUP_SIMPAN_HARI=14

# Masa simpan data pribadi (hari), dijalankan otomatis tiap malam: php artisan resto:bersihkan-data-pribadi
RETENSI_PESANAN_HARI=365
RETENSI_WAJAH_HARI=180
RETENSI_PELANGGAN_HARI=730

# Saat dipakai sungguhan (produksi), ubah:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://nama-domain-resto.com

# Midtrans (pembayaran VA & QRIS otomatis) - isi dari dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
